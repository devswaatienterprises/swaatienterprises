# Swaati Enterprises Environment Configuration

# Server Ports
PORT_WEBSITE=3000
PORT_CRM=3001
PORT_BACKEND=4000

# Backend API Settings
NODE_ENV=development
JWT_SECRET=change_this_to_a_secure_secret_key_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swaatienterprises_db
DB_USER=postgres
DB_PASSWORD=postgres

# Service URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
