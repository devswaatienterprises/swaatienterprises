# Swaati Enterprises Management System (SEMS) - Monorepo Environment Variables Reference

# ----------------------------------------------------
# 1. BACKEND API (.env in backend/ directory)
# ----------------------------------------------------
# PORT=4000
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/swaatienterprises_db?sslmode=require
# JWT_SECRET=your_strong_random_jwt_secret_here
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=https://app.swaatienterprises.in,https://swaatienterprises.in
# FRONTEND_URL=https://swaatienterprises.in
# CRM_URL=https://app.swaatienterprises.in

# ----------------------------------------------------
# 2. CRM FRONTEND (.env in crm/ directory)
# ----------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.swaatienterprises.in/api/v1

# ----------------------------------------------------
# 3. PUBLIC WEBSITE (.env in website/ directory)
# ----------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.swaatienterprises.in/api/v1
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
